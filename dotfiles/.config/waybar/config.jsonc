
{
    "layer": "top",
    "position": "top",
    "height": 45,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/menu",
        "mango/workspaces",
        "mango/window"
    ],

    "modules-center": [
        "clock",
        "mpris"
    ],

    "modules-right": [
        "tray",
        "bluetooth",
        "wireplumber",
        "network",
        "memory",
        "battery",
        "custom/power"
    ],

    "custom/menu": {
        "format": "<span color='#d79921'></span>",
        "tooltip": false,
        "on-click": "fuzzel"
    },

	"mango/workspaces": {
		"format": "{icon}",
		"on-click": "activate"
	},

    "mango/window": {
        "format": "{title}",
        "max-length": 40,
        "icon": true
    },

    "clock": {
        "format": "<span color='#689d6a'></span> {:%A %I:%M:%S %p}",
        "interval": 1,
        "on-click": "bash -c '~/.config/waybar/scripts/quickshell-calendar.sh'",
        "tooltip-format": "<span color='#83a598'><b>{:%B %Y}</b></span>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#83a598'><b>{}</b></span>",
                "weekdays": "<span color='#928374'><b>{}</b></span>",
                "days": "<span color='#ebdbb2'>{}</span>",
                "today": "<span color='#d79921'><b>{}</b></span>"
            }
        }
    },

    "mpris": {
        "format": "<span color='#b16286'>󰏤</span> {dynamic}",
        "format-playing": "<span color='#b16286'>󰝚</span> {dynamic}",
        "format-paused": "<span color='#928374'>󰏤</span> {dynamic}",
        "dynamic-order": [
            "artist",
            "title"
        ],
        "dynamic-separator": " - ",
        "dynamic-len": 32,
        "artist-len": 14,
        "title-len": 18,
        "ellipsis": "…"
    },

    "bluetooth": {
        "format": "<span color='#458588'>󰂯</span>",
        "format-on": "<span color='#458588'>󰂯</span>",
        "format-off": "<span color='#928374'>󰂲</span>",
        "format-disabled": "<span color='#928374'>󰂲</span>",
        "format-connected": "<span color='#458588'>󰂱</span>",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "on-click": "bash -c '~/.config/fuzzel/fuzzel-bluetooth.sh'"
    },

    "wireplumber": {
        "format": "<span color='#98971a'>{icon}</span> {volume}%",
        "format-muted": "<span color='#928374'>󰝟</span> {volume}%",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "tooltip-format": "{node_name}"
    },

    "network": {
        "interval": 5,
        "format-wifi": "<span color='#689d6a'>{icon}</span> {essid}",
        "format-ethernet": "<span color='#689d6a'>󰈀</span>",
        "format-linked": "<span color='#689d6a'>{icon}</span>",
        "format-disconnected": "<span color='#928374'>󰤯</span>",
        "format-disabled": "<span color='#928374'>󰤮</span>",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "foot -e nmtui"
    },

    "memory": {
        "interval": 5,
        "format": "<span color='#d65d0e'>󰍛</span> {used:0.1f}G",
        "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GB ({percentage}%)"
    },

    "battery": {
        "interval": 1,
        "states": {
            "warning": 30,
            "critical": 20
        },
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Low Battery' 'Battery is at or below 30%'",
            "on-discharging-critical": "notify-send -u critical 'Critical Battery' 'Plug in your charger soon'"
        },
        "format": "<span color='#d79921'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#d79921'>󰂄</span> {capacity}%",
        "format-plugged": "<span color='#d79921'>󰂄</span> {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰁹"
        ]
    },

    "custom/power": {
        "format": "<span color='#cc241d'>󰐥</span>",
        "tooltip": false,
        "on-click": "wlogout"
    }
}

