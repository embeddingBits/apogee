
{
    "layer": "top",
    "position": "top",
    "height": 45,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/menu",
        "mango/workspaces",
        "mango/window"
    ],

    "modules-center": [
        "clock",
        "mpris"
    ],

    "modules-right": [
        "tray",
        "bluetooth",
        "wireplumber",
        "network",
        "memory",
        "battery",
        "custom/power"
    ],

    "custom/menu": {
        "format": " ",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    "mango/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-click-right": "toggle",
        "format-icons": {
            "active": "",
            "empty": "",
            "occupied": "",
            "default": ""
        }
    },

    "mango/window": {
        "format": "{title}",
        "max-length": 40,
        "icon": true
    },

    "clock": {
        "format": "{:%A %I:%M:%S %p}",
        "interval": 1,
        "on-click": "bash -c '~/.config/waybar/scripts/quickshell-calendar.sh'",
        "tooltip-format": "<span color='#83a598'><b>{:%B %Y}</b></span>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#83a598'><b>{}</b></span>",
                "weekdays": "<span color='#928374'><b>{}</b></span>",
                "days": "<span color='#ebdbb2'>{}</span>",
                "today": "<span color='#d79221'><b>{}</b></span>"
            }
        }
    },

    "mpris": {
        "format": "<span color='#928374'>|</span>  <span color='#928374'>󰏤</span> {dynamic}",
        "format-playing": "<span color='#928374'>|</span>  <span color='#d79221'>󰝚</span> {dynamic}",
        "format-paused": "<span color='#928374'>|</span>  <span color='#928374'>󰏤</span> {dynamic}",
        "dynamic-order": [
            "artist",
            "title"
        ],
        "dynamic-separator": " - ",
        "dynamic-len": 32,
        "artist-len": 14,
        "title-len": 18,
        "ellipsis": "…"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6,
        "show-passive-items": false
    },

    "bluetooth": {
        "format": "󰂯",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "on-click": "bash -c '~/.config/fuzzel/fuzzel-bluetooth.sh'"
    },

    "wireplumber": {
        "format": "{icon}  <span font_weight='600'>{volume}%</span>",
        "format-muted": "󰝟 <span font_weight='600'>{volume}%</span>",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "tooltip-format": "{node_name}"
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀",
        "format-linked": "{icon}",
        "format-disconnected": "󰤯",
        "format-disabled": "󰤮",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "foot -e nmtui"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛   <span font_weight='600'>{used:0.1f}G</span>",
        "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GB ({percentage}%)"
    },

    "battery": {
        "interval": 1,
        "states": {
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}  <span font_weight='600'>{capacity}%</span>",
        "format-charging": "󰂄 <span font_weight='600'>{capacity}%</span>",
        "format-plugged": "󰂄 <span font_weight='600'>{capacity}%</span>",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰁹"
        ]
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "wlogout"
    }
}

